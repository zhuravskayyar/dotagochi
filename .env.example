# --- Telegram ---
BOT_TOKEN=your_telegram_bot_token
BOT_USERNAME=your_bot_username
WEBAPP_URL=https://your-domain.example.com

# --- Server ---
PORT=3001
NODE_ENV=development
ADMIN_TOKEN=change_me
ANIMATION_STUDIO_ENABLED=true
ROOT_REDIRECT=

# Render Studio: fine-grained PAT with Contents: Read and write for both repos.
# Keep it only in Render secrets; never commit the real value.
GITHUB_TOKEN=
STUDIO_GIT_REMOTE=studio
STUDIO_GIT_REMOTE_URL=https://github.com/zhuravskayyar/dotagochi-studio.git
STUDIO_PUBLISH_REMOTE=origin

# --- Database ---
# Linux launcher replaces this with persistent ~/.local/share storage.
DATABASE_PATH=./src/database/dota-tamagotchi.sqlite

# --- Client (Vite, must be prefixed with VITE_) ---
VITE_API_URL=http://localhost:3001/api
VITE_DEV_USER_ID=local-preview
VITE_STATIC_DEMO=false
VITE_BASE_PATH=/
